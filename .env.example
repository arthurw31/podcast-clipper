# Copiez ce fichier en .env et remplissez les clés.
PEXELS_API_KEY=
# Facultatif : sans clé, la sélection passe par `claude -p` (Claude Code) si installé.
ANTHROPIC_API_KEY=
# Facultatif : navigateur utilisé par HyperFrames pour les aperçus et rendus. À renseigner si
# `python -m clipper doctor` signale que le Chrome embarqué est bloqué (ex. Windows Smart App Control).
# HYPERFRAMES_BROWSER_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
